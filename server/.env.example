# ── LM Select 服务端环境变量示例 ─────────────────────────────────────────────
# 用法：
#   1) 复制本文件为 server/.env
#      PowerShell:  Copy-Item server/.env.example server/.env
#   2) 把下面的值换成你自己的真实配置
#
# 本文件里不含任何真实密钥，可以安全入库；
# 真正的 server/.env 已被 .gitignore 忽略，永远不会被提交。
# 所有变量只作用于服务端，不会下发到浏览器。

# ── MySQL 连接（server/db.js 读取）──────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lm_select

# ── Ollama 本地模型服务地址 ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── 登录系统（server/auth/config.js 读取）──────────────────────────────────
# JWT 签名密钥：至少 32 位随机串，泄露等于任何人都能伪造登录态。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
# 登录令牌有效期（天），到期需重新登录
AUTH_TOKEN_TTL_DAYS=
# 连续输错密码几次锁定、锁定多少分钟
AUTH_MAX_FAILED=
AUTH_LOCK_MINUTES=
# Cookie 是否只允许 HTTPS 传输。本地 http://127.0.0.1 必须为 false，
# 否则表现为「登录成功但刷新就掉线」
AUTH_COOKIE_SECURE=false

# ── 厂商 API key（server/providers/index.js 读取）──────────────────────────
# 各厂商都可用 <厂商>_BASE_URL 覆盖默认地址，便于切换区域或走代理
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ARK_API_KEY=

# ── OpenAI / Anthropic（开发期可经 New API 一类中转站接入）──────────────────
# 换成官方 key 时注意：OpenAI 改 OPENAI_BASE_URL 为 https://api.openai.com/v1；
# 官方 Anthropic 的 /v1 下没有 /chat/completions，需要另写原生适配器。
OPENAI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
